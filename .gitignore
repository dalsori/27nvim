# ════════════════════════════════════════════════════════════════════
#  CLAINEV — Neovim Config .gitignore
# ════════════════════════════════════════════════════════════════════

# ── Runtime / cache (generado automáticamente por Neovim) ─────────
plugin/packer_compiled.lua
ftplugin/

# vim.pack: nvim-pack-lock.json is committed for reproducible installations.
# Private, machine-specific plugins must not be published.
lua/clainev/plugins/local.lua

# ── Neovim session / swap / undo (si alguien los guarda en el config) ─
*.swp
*.swo
*~
.netrwhist
Session.vim
.session/

# ── Secretos / credenciales ───────────────────────────────────────
.env
.env.*
secrets.lua
**/secrets/**

# ── Datos de plugins (se regeneran solos) ────────────────────────
spell/

# ── OS ────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Editores externos ─────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
